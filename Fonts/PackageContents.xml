            LoadOnAutoCADStartup="True"
        />
        
        <!-- Componente para o LSP (carrega automaticamente) -->
        <ComponentEntry
            AppName="ArkZ 3D Hedron LSP"
            Version="1.0.0"
            ModuleName="./Contents/Windows/ArkZ3DHedron.lsp"
            AppDescription="ArkZ 3D Hedron"
            LoadOnAutoCADStartup="True"
        />
        
        <!-- Comando principal - Note: mantive ARKZREDEF em maiúsculas para consistência -->
        <Command Local="ArkZ3DHedron" Group="Ark-Z" Global="ArkZ3DHedron">
